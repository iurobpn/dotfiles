# Gruvbox Color Scheme for Taskwarrior

# Header and summary
color.header=bold white on yellow       # Bold white on yellow
color.footnote=bold white on yellow     # Bold white on yellow
color.summary.background=yellow         # Yellow background
color.summary.foreground=black          # Black text

# Task attributes
color.project=bold blue                 # Blue
color.tag=bold green                    # Green
color.due=bold red                      # Red
color.priority=bold magenta             # Magenta
color.active=bold cyan                  # Cyan
color.completed=bold white              # White
color.deleted=bold red                  # Red

# Overdue tasks
color.overdue=bold red on black         # Red on black

# Recurring tasks
color.recurring=bold yellow             # Yellow

# Urgency levels
color.urgency.high=bold red             # Red
color.urgency.medium=bold yellow        # Yellow
color.urgency.low=bold green            # Green
color.urgency.none=bold white           # White

# Calendar colors
color.calendar.today=bold cyan on black         # Cyan on black
color.calendar.due=bold red on black            # Red on black
color.calendar.due.today=bold red on cyan       # Red on cyan
color.calendar.overdue=bold red on black        # Red on black
color.calendar.holiday=bold yellow on black     # Yellow on black
color.calendar.weekend=bold magenta on black    # Magenta on black
color.calendar.weeknumber=bold white on black   # White on black
color.calendar.header=bold white on yellow      # Bold white on yellow

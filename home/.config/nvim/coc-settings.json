{
    "settings": {
        // Unrelated settings...
        "languageserver": {
            "lua": {
                "cwd": "/opt/lua-language-server/bin",
                "command": "/opt/lua-language-server/bin/lua-language-server",
                "filetypes": ["lua"],
                "rootPatterns": [".git/"]
            }
        },
        "Lua": {
            "workspace": {
                "library": [
                ],
                "userThirdParty": [
                    "~/git/scripts/lua",
                    "~/git/scripts/lua/dev"
                ],
                "maxPreload": 2000,
                "preloadFileSize": 1000
            },
            "runtime": {
                "version": "Lua 5.1"
            },
            "diagnostics": {
                "enable": true,
                "globals": ["hs", "vim",  "dev", "it", "describe", "before_each", "after_each"],
                "disable": ["lowercase-global"],
                "workspaceEvent": "none",
                "workspaceRate": 0
            },
            "completion": {
                "keywordSnippet": "Disable"
            }
        },
        "clangd": {
            "enable": true,
            "path": "/usr/bin/clangd",
            "args": ["-log=verbose", "-pretty", "--background-index", "--clang-tidy"],
            "filetypes": ["c","cpp","objc","objcpp", "h", "hpp"],
            "rootPatterns": [".git/","compile_commands.json"],
            "semanticTokens": { 
                "enable": true
            }
        },
        "stylua": {
            "formatOnSave": true,
            "formatCommand": "stylua",
            "formatFiletypes": ["lua"]
        },
        "ltex": {
            "enabled": true,
            "language": "auto",
            "disabledRules":  {
                "en": [
                    "COMMA_PARENTHESIS_WHITESPACE",
                    "EN_UNPAIRED_PARENTHESIS",
                    "EN_UNPAIRED_BRACKETS",
                    "ARROW"
                ],
                "pt-BR": [
                    "COMMA_PARENTHESIS_WHITESPACE",
                    "ARROW"
                ]        
            }
        }
    }
}

[settings]
default-library = gagarin
opentool = zathura
editor = nvim
use-git = False
notes-name = notes.md
database-backend = papis
bibtex-unicode = False
ref-format = {doc[title]:.15} {doc[author]:.6} {doc[year]}
multiple-authors-format = {au[family]}, {au[given]}
citations-file-name = citations.yaml
picktool = fzf
file-browser = lf

[gagarin]
dir = /home/gagarin/Koofr/papis

[OJITS]
dir = /home/gagarin/Koofr/papers/OJITS/papis


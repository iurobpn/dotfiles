# abbr notestab 'zellij action new-tab --layout notes --cwd ~/sync/obsidian --name notes'
abbr newtab 'zellij action new-tab --layout default'
abbr ta 'task add'
abbr tl 'task list'
abbr tlp 'task list project:'
abbr tap 'task add project:'
abbr tw 'task'
abbr tc 'task context'

alias b='buku --suggest'
abbr bi 'buku --ai' # auto import from browsers
abbr ba 'buku -w' # add a bookmark
abbr bl 'buku -p' # list bookmarks
abbr bu 'b -u' # update a bookmark

abbr pl 'papis list'
abbr pa 'papis add'
abbr pato 'papis add'
abbr po 'papis open'

abbr fetch 'gita fetch'
# abbr pull 'gita pull (gita ll | awk \'!/\[\]/ { print $1 }\')'
abbr gt 'gita'
abbr gtu 'gita pull'
abbr gtd 'gita push'
abbr gtl 'gita ll'
abbr gt 'gita ll'

abbr tros 'tmux new-session -s ros bash \; set-option default-shell /bin/bash \; set-option /bin/bash'
abbr tma 'tmux attach'
abbr tmk 'tmux kill-session'
abbr tmks 'tmux kill-server'
abbr vtm 'nvim ~/.config/tmux/tmux.conf'


abbr cb 'colcon build'
abbr sros 'bass source /opt/ros/jazzy/setup.bash'
abbr sws 'bass source ~/ros2_ws/install/setup.bash'
abbr srmf 'bass source ~/rmf_ws/install/setup.bash'


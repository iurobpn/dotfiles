{
    "stage": {
        "cmd": "git add .",
        "help": "git add ."
    },
    "log": {
        "cmd": "git log --online",
        "disable_async": true,
        "help": "show logs"
    },
    "lg": {
        "cmd": "lazygit",
        "disable_async": true,
        "help": "lazygit"
    },
    "last": {
        "cmd": "git last",
        "help": "git last"
    },
    "stat": {
        "cmd": "git diff --stat",
        "help": "show edit statistics"
    }
}

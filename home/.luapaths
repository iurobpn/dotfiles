#!/bin/bash
# vim: set ft=bash:
if command -v luarocks > /dev/null 2>&1; then
    eval $(luarocks path --bin)
    # export LUA_PATH="$LUA_PATH;$HOME/git/scripts/lua/?.lua;$HOME/git/scripts/lua/?/init.lua;$HOME/git/scripts/lua/?.lua"
    # export LUA_PATH="$LUA_PATH;$HOME/git/scripts/lua/?.lua"
else
    echo "luarocks is not installed"
fi
export LUA_PATH="$LUA_PATH;$HOME/git/scripts/lua/?.lua;$HOME/.config/nvim/lua/?.lua;$HOME/.config/nvim/lua/?/init.lua"
